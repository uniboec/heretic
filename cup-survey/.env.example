# On Windows Prisma may fail with localhost — use 127.0.0.1 instead.
DATABASE_URL="postgresql://cup_survey:cup_survey@127.0.0.1:5433/cup_survey?schema=public"
# Integration tests use a separate database so dev demo data is not wiped.
# INTEGRATION_DATABASE_URL="postgresql://cup_survey:cup_survey@127.0.0.1:5433/cup_survey_test?schema=public"
# npm run set-admin-password -- your-password
ADMIN_PASSWORD_HASH_B64=
# Опционально: отдельный пароль для рабочего места ковра (без доступа к коррекции результатов)
MAT_OPERATOR_PASSWORD_HASH_B64=
ADMIN_SESSION_SECRET=""
# Playwright E2E: пароль админки (должен совпадать с set-admin-password)
# E2E_ADMIN_PASSWORD=
# E2E_MAT_OPERATOR_PASSWORD=
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# Phase 2 выпуска поединок: visible и boutsReleased независимы (по умолчанию Phase 1 dual-write).
# INDEPENDENT_BOUTS_RELEASE=true

# Bracket v7: после cutover — только ACTIVE singleton (см. docs/bracket-cutover-runbook.md)
# BRACKETS_ACTIVE_ONLY=true
# Для production обязателен; локально без переменной используется dev-заглушка.
# BRACKET_IMPACT_TOKEN_SECRET="change-me-in-production"

# Реквизиты оплаты (не хардкодить во frontend)
PAYMENT_RECIPIENT_NAME="ООО Пример"
PAYMENT_INN=""
PAYMENT_ACCOUNT=""
PAYMENT_BANK_NAME=""
PAYMENT_BIK=""
PAYMENT_CORR_ACCOUNT=""
PAYMENT_PURPOSE_TEMPLATE="Оплата участия в турнире. Заявка №{number}"

# Голосовой информатор (TTS + shared cache для web и worker)
# ANNOUNCER_CACHE_DIR=/app/data/announcer-cache
# ANNOUNCER_CUES_DIR=/app/data/announcer-cues
# ANNOUNCER_SCOPE_ID=cup-2026
# YANDEX_SPEECH_API_KEY=
# YANDEX_SPEECH_KEY_ID=
# YANDEX_SPEECH_FOLDER_ID=  # optional, only for IAM-token auth
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_KEY_FALLBACK=
# AZURE_SPEECH_REGION=uaenorth
# GOOGLE_TTS_API_KEY=
# EDGE_TTS_URL=http://127.0.0.1:5500
# PIPER_TTS_URL=http://127.0.0.1:5000
# SILERO_TTS_URL=http://127.0.0.1:5001

# Уведомления организатору (регистрация и оплата)
ORGANIZER_NOTIFICATION_EMAIL="pervomma@yandex.ru"
# SMTP Яндекса: пароль приложения в настройках почты
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# SMTP_FROM=""  # по умолчанию = SMTP_USER
