# Скопировать на VPS как /opt/cup-survey/.env

POSTGRES_USER=cup_survey
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cup_survey

APP_PORT=3001

DATABASE_URL="postgresql://cup_survey:CHANGE_ME_STRONG_PASSWORD@postgres:5432/cup_survey?schema=public"

# npm run set-admin-password -- 'your-password'
ADMIN_PASSWORD_HASH_B64=

# openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# openssl rand -base64 32 — подпись impactToken для опасных операций с сетками
BRACKET_IMPACT_TOKEN_SECRET=""

NEXT_PUBLIC_SITE_URL="https://cup26.mma66.ru"
ALLOWED_ORIGINS="https://cup26.mma66.ru,https://mma66.ru"

# Phase 2 выпуска поединок — включать только после backfill (deploy/DEPLOY.md § Bouts release).
# INDEPENDENT_BOUTS_RELEASE=true

# Уведомления организатору
