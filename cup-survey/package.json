{
  "name": "cup-survey",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start",
    "deploy:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "lint": "eslint .",
    "ui-debt": "node scripts/ui-debt-scoreboard.mjs",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .stylelintignore",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:test:prepare": "npx tsx scripts/prepare-integration-db.ts",
    "db:generate": "prisma generate",
    "db:pull-prod": "python ..\\pull-cup26-prod-db-local.py",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:mat-control-reliability": "vitest run --config vitest.integration.config.ts lib/bouts/__tests__/matControl.reliability.integration.test.ts",
    "pretest:integration": "npm run db:test:prepare",
    "test:staging-perf": "vitest run --config vitest.staging-perf.config.ts lib/brackets/__tests__/integration/dashboardPerf.integration.test.ts",
    "test:ci": "npm run test && npm run test:integration && npm run benchmark:club-separation && npm run benchmark:balanced-draw",
    "benchmark:club-separation": "npx tsx scripts/benchmark-club-separation.ts",
    "benchmark:balanced-draw": "npx tsx scripts/benchmark-balanced-draw.ts",
    "test:e2e": "playwright test",
    "test:e2e:mat-control": "playwright test tests/e2e/mat-control.spec.ts tests/e2e/scoreboard.spec.ts tests/e2e/mat-control-live.spec.ts tests/e2e/mat-control-full-flow.spec.ts",
    "test:e2e:visual": "playwright test tests/e2e/visual.spec.ts --grep @visual",
    "test:e2e:visual:update": "playwright test tests/e2e/visual.spec.ts --grep @visual --update-snapshots",
    "hash-password": "node scripts/hash-password.mjs",
    "set-admin-password": "node scripts/set-admin-password.mjs",
    "seed:clubs": "npx tsx scripts/seed-clubs.ts",
    "seed:registration-schedule": "npx tsx scripts/seed-registration-schedule.ts",
    "seed:registrations": "npx tsx scripts/seed-registrations.ts",
    "seed:athletes": "npx tsx scripts/seed-random-athletes.ts",
    "fix:registration-stages": "npx tsx scripts/fix-registration-stage-ids.ts",
    "seed:bracket-sizes": "npx tsx scripts/seed-bracket-size-categories.ts",
    "seed:local-demo-50": "npx tsx scripts/seed-local-demo-50.ts",
    "brackets:sync": "npx tsx scripts/sync-brackets.ts",
    "brackets:reconcile-publication": "npx tsx scripts/reconcile-bracket-publication-state.ts",
    "brackets:cutover": "npx tsx scripts/migrate-brackets-single-live.ts",
    "backfill:bouts-release": "npx tsx scripts/backfill-bouts-release-state.ts",
    "backfill:champion-singletons": "npx tsx scripts/backfill-champion-singletons.ts",
    "backfill:schedule-display-numbers": "npx tsx scripts/backfill-schedule-display-numbers.ts",
    "report:unresolved-frozen-numbers": "npx tsx scripts/report-unresolved-frozen-numbers.ts",
    "ensure:schedule-legacy-gap": "npx tsx scripts/ensure-schedule-legacy-gap.ts",
    "repair:schedule-legacy": "npx tsx scripts/repair-schedule-legacy.ts",
    "enable-auto-mat-by-category": "npx tsx scripts/enable-auto-mat-by-category.ts",
    "setup:local-public": "npx tsx scripts/setup-local-public.ts",
    "tournament:conduct": "npx tsx scripts/conduct-local-tournament.ts",
    "tournament:conduct:v2": "npx tsx scripts/conduct-local-tournament-v2.ts",
    "brackets:apply-experienced-groups": "cross-env CUP_SURVEY_SCRIPT_MODE=1 npx tsx scripts/apply-experienced-bracket-groups.ts",
    "announcer:worker": "npx tsx scripts/announcer-worker.ts",
    "announcer:worker:dev": "node -r dotenv/config ./node_modules/tsx/dist/cli.mjs scripts/announcer-worker.ts",
    "announcer:tts-server": "node scripts/local-tts-server.mjs",
    "announcer:setup-local": "npx tsx scripts/setup-local-announcer.ts",
    "announcer:install-sounds": "node scripts/install-announcer-cue-sounds.mjs",
    "announcer:generate-sounds": "node scripts/install-announcer-cue-sounds.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "@tanstack/react-query": "^5.103.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "docx": "^9.8.1",
    "html2canvas-pro": "^2.5.0",
    "jose": "^6.1.0",
    "libphonenumber-js": "^1.12.15",
    "lucide-react": "^1.46.0",
    "next": "^16.1.6",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.1.6",
    "prisma": "^6.16.2",
    "server-only": "^0.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
