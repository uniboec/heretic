{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": ["app/globals.css", "**/node_modules/**"],
  "rules": {
    "color-no-hex": [
      true,
      {
        "message": "Use @theme canonical tokens instead of hex colors outside globals.css"
      }
    ],
    "declaration-no-important": [
      true,
      {
        "severity": "warning",
        "message": "Avoid !important except reduced-motion/print overrides"
      }
    ],
    "selector-type-no-unknown": [
      true,
      {
        "ignoreTypes": ["/^app-/"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["components/tournament/brackets/bracket.css"],
      "rules": {
        "selector-class-pattern": null,
        "no-descending-specificity": null,
        "selector-max-specificity": null,
        "media-feature-range-notation": null,
        "declaration-block-no-redundant-longhand-properties": null,
        "declaration-property-value-keyword-no-deprecated": null,
        "alpha-value-notation": null,
        "declaration-no-important": null
      }
    },
    {
      "files": ["styles/base.css"],
      "rules": {
        "alpha-value-notation": null,
        "selector-class-pattern": null,
        "declaration-block-single-line-max-declarations": null,
        "declaration-no-important": null
      }
    }
  ]
}
